FROM nginx:alpine

# Copia los archivos estáticos del frontend
COPY frontend/ /usr/share/nginx/html/

# Inyecta la URL del backend en config.js en tiempo de inicio del contenedor
# (La variable BACKEND_URL se pasa via docker-compose)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["/bin/sh", "-c", \
  "sed -i \"s|http://localhost:8000|${BACKEND_URL:-http://localhost:8000}|g\" /usr/share/nginx/html/config.js && nginx -g 'daemon off;'"]
