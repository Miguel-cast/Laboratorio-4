# ──────────────────────────────────────────────
#  .env.example  —  copia a .env y ajusta valores
# ──────────────────────────────────────────────

# PostgreSQL — variables usadas por Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin123
POSTGRES_DB=reservas_db

# Cadena completa de conexión (usada por el backend)
# En Docker: @db:5432  |  En dev local: @localhost:5432
DATABASE_URL=postgresql://postgres:admin123@db:5432/reservas_db

# JWT
SECRET_KEY=cambia_esta_clave_por_una_segura_en_produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Seed — usuario administrador inicial
ADMIN_EMAIL=admin@correo.com
ADMIN_PASSWORD=admin123
ADMIN_NOMBRE=Administrador

# URL del backend que usa el frontend (para Docker usa el nombre del servicio)
# En modo dev local: http://localhost:8000
BACKEND_URL=http://localhost:8000
